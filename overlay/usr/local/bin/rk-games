#!/bin/bash
# Games on the dock: RetroArch, with the owner's own game files.
#
#   rk-games prepare    make the folders games are looked for in (run by the
#                       dock just before RetroArch starts)
#   rk-games where      print the games folder
#
# No game and no BIOS file comes with the system. Copy your own into the
# folder for their machine: with the card in a computer (the RKSHARE
# partition, folder roms), over SSH/SFTP, or from a USB stick in Files.
#
# /data/ark/roms is a link to /share/roms, the part of the card a computer
# can read, once the card has one (rk-share): RetroArch keeps one path.
set -u
ROMS=/data/ark/roms
[ -d /data/ark ] || ROMS="${HOME:-/home/ark}/roms"
# the link with the visible partition not mounted: do not write under it
[ -L "$ROMS" ] && [ ! -d "$ROMS" ] && ROMS="${HOME:-/home/ark}/roms"
[ -L "$ROMS" ] && ROMS=$(readlink -f "$ROMS")

case "${1:-}" in
    prepare)
        for d in psx n64 psp nes snes gb gbc gba megadrive mastersystem gamegear pcengine bios saves states; do
            mkdir -p "$ROMS/$d"
        done
        [ -e "$ROMS/README.txt" ] || cat > "$ROMS/README.txt" 2>/dev/null <<TXT
Your games go here, one folder per machine:

  psx  n64  psp  nes  snes  gb  gbc  gba  megadrive  mastersystem  gamegear  pcengine

bios    files some machines need to start (yours to supply)
saves   what games save;  states  save states made from RetroArch's menu

Open Games on the handheld: it finds them and shows them by machine.
A starts a game. In a game, SELECT+START comes back, SELECT+X opens
RetroArch's menu.
TXT
        ;;
    where) echo "$ROMS" ;;
    *) echo "usage: rk-games prepare | where" >&2; exit 2 ;;
esac
