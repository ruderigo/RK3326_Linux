#!/bin/sh
# FireFly and the Stump both want Reticulum's local-network port (UDP 29716),
# so the Stump steps aside while FireFly is open and comes back when FireFly
# quits. The dock runs "pause" before FireFly and "resume" after it
# (firefly.json). Resume only restarts a Stump that pause stopped.
S="${HOME:-/home/ark}/Stump"; MARK=/tmp/stump-paused-by-firefly; ME=$(id -un)
case "$1" in
pause)
  pgrep -f "$S/stump_pc.py" >/dev/null || exit 0
  sh "$S/stop-stump.sh" >/dev/null 2>&1      # the Stump's own off switch (radio off first)
  touch "$MARK"
  i=0; while [ $i -lt 20 ] && pgrep -f "$S/stump_pc.py" >/dev/null; do sleep 0.5; i=$((i+1)); done
  pgrep -f "$S/stump_pc.py" >/dev/null && { pkill -TERM -f "$S/stump_pc.py"; sleep 1; }
  ;;
resume)
  [ -f "$MARK" ] || exit 0
  rm -f "$MARK"
  if systemctl cat "stump-$ME" >/dev/null 2>&1; then sudo -n systemctl start "stump-$ME"
  else systemctl --user start stump 2>/dev/null || (sh "$S/start-stump.sh" >/dev/null 2>&1 &)
  fi
  ;;
*) echo "usage: rk-stump-pause pause|resume" >&2; exit 2 ;;
esac
exit 0
