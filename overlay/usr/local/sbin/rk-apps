#!/bin/bash
# The dock apps (Ember, FireFly, Stump, the Provisioner, STUMP Recon): fetch
# them, see their versions, update them. Over Wi-Fi, into /home/ark where the
# dock's launchers look. The AppManager window on the dock runs this.
#
#   rk-apps status                     what is installed
#   rk-apps versions                   installed and newest version of each
#   rk-apps install ember|firefly|stump|provisioner|stump-recon|all     (from each one's latest release)
#   rk-apps update ember|firefly|stump|provisioner|stump-recon|all
#   rk-apps source firefly|stump stable|sandbox  where FireFly/Stump updates come from
#
# An update takes FireFly and the Stump from the main branch of their
# repositories (their GitHub releases lag behind), and Ember and the
# Provisioner from their newest release (Ember's binary is only built for
# releases; the Provisioner's release carries its firmware). STUMP Recon
# comes with the system (/usr/share/rk/bundled) and from its repository once
# that publishes a higher version. Each app's own installer
# does the work, so its data and settings are kept as that installer keeps
# them.
#
# Runs as the ark user. The installers need root for a few steps: over SSH
# sudo asks in the terminal; from the desktop the password comes through
# sudo's askpass helper (SUDO_ASKPASS), which all three installers accept.
set -u
say() { echo "rk-apps: $*"; }
H="${HOME:-/home/ark}"
online() { ip route 2>/dev/null | grep -q '^default'; }

# the checks made before anything is fetched: room, memory (see the file)
RK_WHO=rk-apps
. "${RK_LIB:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../lib/rk}/preflight.sh"
# Each app lives under the home folder (on the data partition once the card
# has been started; rk-migrate moves the large parts there). MB an install or
# update can take while old and new are both on the card, and the memory its
# installer needs (FireFly's builds a Python environment).
room_for() {        # room_for APP [update]
    local mb mem=0
    case "$1${2:+-$2}" in
        ember|ember-update) mb=60 ;;
        firefly)        mb=350; mem=100 ;;
        firefly-update) mb=120; mem=100 ;;      # the new files beside the old; its Python environment is there already
        stump)          mb=250; mem=60 ;;
        stump-update)   mb=40;  mem=60 ;;       # a few MB of files, and room to work in
        provisioner|provisioner-update) mb=90 ;; # the release, unpacked, and its copy in the home folder
        stump-recon|stump-recon-update) mb=15 ;; # two Python files and a launcher, and a checkout when its repository has a newer one
        *)              return 0 ;;
    esac
    rk_need_space "$mb" "$(readlink -f "$H" 2>/dev/null || echo "$H")" "$1" || return 1
    [ "$mem" -eq 0 ] || rk_need_mem "$mem" "installing $1" || return 1
}

api_asset() {   # print the browser_download_url of the first release asset matching $2 in repo $1
    curl -fsSL "https://api.github.com/repos/$1/releases/latest" |
        python3 -c "import json,sys,re
d=json.load(sys.stdin)
for a in d.get('assets',[]):
    if re.search(sys.argv[1], a['name']): print(a['browser_download_url']); break" "$2"
}

install_ember() {
    say "Fetching Ember (prebuilt arm64)..."
    mkdir -p "$H/ports"
    if curl -fsSL https://github.com/ruderigo/Ember/releases/latest/download/ember-arkos-arm64.tar.gz \
            | tar xz --no-same-owner -C "$H/ports"; then
        chmod +x "$H/ports/Ember.sh" 2>/dev/null
        ember_latest > "$H/ports/ember/.rk-version" 2>/dev/null
        # Ember's launcher runs "sudo chmod 666 /dev/tty1"; on our desktop ark
        # owns tty1, so drop the sudo (it would prompt for a password with no
        # way to answer it).
        sed -i 's/^\( *\)sudo /\1/' "$H/ports/Ember.sh" 2>/dev/null
        say "Ember installed in $H/ports."
    else
        say "could not fetch Ember."; return 1
    fi
}

install_firefly() {
    say "Fetching FireFly..."
    local url; url=$(api_asset ruderigo/FireFly_RK3326_R36MAX_R36S 'FireFly-RK3326-.*\.zip')
    [ -n "$url" ] || { say "could not find a FireFly release asset."; return 1; }
    local tmp; tmp=$(rk_tmpdir rk-firefly)
    if ! curl -fsSL "$url" -o "$tmp/firefly.zip"; then say "download failed."; rm -rf "$tmp"; return 1; fi
    ( cd "$tmp" && python3 -m zipfile -e firefly.zip . ) || { say "could not unzip FireFly."; rm -rf "$tmp"; return 1; }
    local src; src=$(find "$tmp" -maxdepth 4 -name install.sh -path '*deploy*' | head -1)
    [ -n "$src" ] || { say "no deploy/install.sh in the zip."; rm -rf "$tmp"; return 1; }
    say "Running FireFly's own installer..."
    ( cd "$(dirname "$src")/.." && bash deploy/install.sh ) && say "FireFly installed in $H/firefly." || say "FireFly installer reported a problem (see its output)."
    # python's zipfile does not keep the executable bit, so the dock would see
    # the launcher as not runnable: put it back.
    chmod +x "$H/firefly/deploy/"*.sh 2>/dev/null
    rm -rf "$tmp"
}

clone_stump() {
    say "Fetching Stump ($STUMP_SOURCE) ..."
    local url="https://github.com/ruderigo/$STUMP_REPO"
    if [ -d "$H/R36MAX-Stump/.git" ]; then
        ( cd "$H/R36MAX-Stump" \
          && git remote set-url origin "$url" \
          && git fetch --depth 1 origin main \
          && git reset --hard origin/main ) && say "Stump updated from $STUMP_SOURCE." || { say "could not update Stump."; return 1; }
    elif git clone --depth 1 "$url" "$H/R36MAX-Stump"; then
        say "Stump cloned from $STUMP_SOURCE."
    else
        say "could not fetch Stump."; return 1
    fi
}

# The Provisioner (the board bench: flashes ESP32 boards, makes a Stump on
# one). Its releases carry everything, the firmware and its own installer,
# and all of them are pre-releases so far, which GitHub's "latest release"
# skips: the newest is read from the repository's tags instead. Only its
# sandbox repository exists today.
PROVISIONER_REPO=SandBox_RK3326_Provisioner
PROVISIONER_APP="$H/rk3326_provisioner"
newest_tag() {      # `git ls-remote --tags` on stdin -> the newest version, without its v
    # Ranked as versions are: 0.3.0-beta.24 above 0.3.0-beta.8, and a plain
    # 0.3.0 above every 0.3.0-something.
    python3 -c '
import re, sys
best = None
for line in sys.stdin:
    m = re.search(r"refs/tags/v(\d+(?:\.\d+)*)(?:-([0-9A-Za-z.-]+))?$", line.strip())
    if not m:
        continue
    suffix = [(0, int(p), "") if p.isdigit() else (1, 0, p) for p in (m.group(2) or "").split(".") if p]
    key = (tuple(int(n) for n in m.group(1).split(".")), m.group(2) is None, suffix)
    if best is None or key > best[0]:
        best = (key, m.group(1) + ("-" + m.group(2) if m.group(2) else ""))
if best:
    print(best[1])'
}
provisioner_latest() {
    timeout 20 git ls-remote --tags "https://github.com/ruderigo/$PROVISIONER_REPO" 2>/dev/null | newest_tag
}
install_provisioner() {     # also its update: the installer keeps what it should
    local v; v=$(provisioner_latest)
    [ -n "$v" ] || { say "could not find a Provisioner release."; return 1; }
    say "Fetching the Provisioner $v..."
    local name="RK3326-Provisioner-$v" rc
    local from="https://github.com/ruderigo/$PROVISIONER_REPO/releases/download/v$v"
    local tmp; tmp=$(rk_tmpdir rk-provisioner)
    if ! curl -fsSL "$from/$name.tar.gz" -o "$tmp/$name.tar.gz" || ! curl -fsSL "$from/SHA256SUMS" -o "$tmp/SHA256SUMS"; then
        say "download failed."; rm -rf "$tmp"; return 1
    fi
    if ! ( cd "$tmp" && grep -F "$name.tar.gz" SHA256SUMS | sha256sum -c --status ); then
        say "the download does not match its checksum: nothing was installed."; rm -rf "$tmp"; return 1
    fi
    tar xzf "$tmp/$name.tar.gz" --no-same-owner -C "$tmp" && [ -f "$tmp/$name/install.sh" ] ||
        { say "the release has no install.sh."; rm -rf "$tmp"; return 1; }
    say "Running the Provisioner's own installer..."
    bash "$tmp/$name/install.sh"; rc=$?
    rm -rf "$tmp"
    [ "$rc" -eq 0 ] || { say "the Provisioner's installer stopped (its message is above)."; return 1; }
    say "The Provisioner is now $(head -1 "$PROVISIONER_APP/VERSION" 2>/dev/null)."
}

# STUMP Recon (LoRa and 2.4 GHz recon with a Heltec V3 or another ESP32 board
# on USB). A copy travels with the system, in /usr/share/rk/bundled: it is on
# a fresh card, an OS update brings it to a card that is not flashed again,
# and it installs with no network. Its repository's main branch is used
# instead once it carries a higher VERSION and the same deploy/install.sh.
RAW=https://raw.githubusercontent.com/ruderigo
STUMP_RECON_REPO=stump-rf-recon
STUMP_RECON_APP="$H/stump-rf-recon"
STUMP_RECON_BUNDLED="${RK_BUNDLED:-/usr/share/rk/bundled}/stump-rf-recon"
stump_recon_published() {   # the VERSION on its repository's main branch; nothing when there is none
    online || return 0
    curl -fsSL -m 10 "$RAW/$STUMP_RECON_REPO/main/VERSION" 2>/dev/null | head -1 | tr -d '\r' | grep -E '^[0-9][0-9A-Za-z.+-]*$'
}
stump_recon_newest() {      # "VERSION WHERE": the higher of the system's copy and the published one
    local b p
    b=$(head -1 "$STUMP_RECON_BUNDLED/VERSION" 2>/dev/null); p=$(stump_recon_published)
    if [ -n "$p" ] && { [ -z "$b" ] || [ "$(printf '%s\n%s\n' "$b" "$p" | sort -V | tail -1)" != "$b" ]; }; then
        echo "$p repository"
    elif [ -n "$b" ]; then
        echo "$b system"
    fi
}
install_stump_recon() {     # also its update: the installer writes over the app and keeps the captures on /data
    local v where src rc
    read -r v where <<<"$(stump_recon_newest)"
    [ -n "$v" ] || { say "STUMP Recon is not in this system and its repository has no version yet."; return 1; }
    src=$STUMP_RECON_BUNDLED
    if [ "$where" = repository ]; then
        say "Fetching STUMP Recon $v from its repository..."
        src="$H/.cache/rk-apps/$STUMP_RECON_REPO"
        if ! sync_repo "$STUMP_RECON_REPO" "$src" || [ ! -f "$src/deploy/install.sh" ]; then
            [ -f "$STUMP_RECON_BUNDLED/deploy/install.sh" ] || { say "could not fetch STUMP Recon."; return 1; }
            say "could not fetch it: installing the copy that came with the system."
            src=$STUMP_RECON_BUNDLED
        fi
    else
        say "Installing STUMP Recon $v (the copy that came with the system)..."
    fi
    say "Running STUMP Recon's own installer..."
    bash "$src/deploy/install.sh"; rc=$?
    [ "$rc" -eq 0 ] || { say "STUMP Recon's installer stopped (its message is above)."; return 1; }
    chmod +x "$STUMP_RECON_APP/STUMP-Recon.sh" 2>/dev/null
    say "STUMP Recon is now $(head -1 "$STUMP_RECON_APP/VERSION" 2>/dev/null)."
}

# ------------------------------------------------------------ versions
# FireFly and Stump each have two repositories: the published one, and the
# sandbox where new versions land first. "rk-apps source firefly|stump sandbox"
# (or Y in the AppManager window) switches; the choice is kept in ~/.config/rk-apps.
CONF="$H/.config/rk-apps"
FIREFLY_SOURCE=stable
STUMP_SOURCE=stable
[ -r "$CONF" ] && . "$CONF"
case "$FIREFLY_SOURCE" in
    sandbox) FIREFLY_REPO=SandBox_FireFly_RK3326 ;;
    *) FIREFLY_SOURCE=stable; FIREFLY_REPO=FireFly_RK3326_R36MAX_R36S ;;
esac
case "$STUMP_SOURCE" in
    sandbox) STUMP_REPO=SandBox_RK3326_Stump ;;
    *) STUMP_SOURCE=stable; STUMP_REPO=R36MAX-Stump ;;
esac

set_conf() {        # set KEY=VALUE in CONF, keeping the other keys
    mkdir -p "$(dirname "$CONF")"
    if [ -f "$CONF" ] && grep -q "^$1=" "$CONF"; then
        sed -i "s#^$1=.*#$1=$2#" "$CONF"
    else
        echo "$1=$2" >> "$CONF"
    fi
}
py_version() { sed -n 's/^__version__ *= *"\([^"]*\)".*/\1/p' | head -1; }
ember_latest() {    # the tag the "latest release" link leads to, without its v
    curl -fsSLI -m 10 -o /dev/null -w '%{url_effective}' https://github.com/ruderigo/Ember/releases/latest 2>/dev/null |
        sed -n 's#.*/tag/v\{0,1\}##p'
}
versions() {        # one line each: id|name|installed|newest|source   ("-" not installed, "?" not known)
    local i a
    i=$(py_version < "$H/firefly/firefly/__init__.py" 2>/dev/null)
    a=$(curl -fsSL -m 10 "$RAW/$FIREFLY_REPO/main/firefly/firefly/__init__.py" 2>/dev/null | py_version)
    [ -x "$H/firefly/deploy/FireFly.sh" ] || i=-
    echo "firefly|FireFly|${i:-?}|${a:-?}|$FIREFLY_SOURCE"
    i=$(head -1 "$H/R36MAX-Stump/handheld/VERSION" 2>/dev/null)
    a=$(curl -fsSL -m 10 "$RAW/$STUMP_REPO/main/handheld/VERSION" 2>/dev/null | head -1)
    [ -f "$H/Stump/stump_pc.py" ] && [ -x "$H/stump_r36max/stump_r36max_engine" ] || i=-
    echo "stump|Stump|${i:-?}|${a:-?}|$STUMP_SOURCE"
    i=$(head -1 "$H/ports/ember/.rk-version" 2>/dev/null)
    [ -x "$H/ports/Ember.sh" ] || i=-
    echo "ember|Ember|${i:-?}|$(a=$(ember_latest); echo "${a:-?}")"
    i=$(head -1 "$PROVISIONER_APP/VERSION" 2>/dev/null)
    [ -x "$PROVISIONER_APP/RK3326_Provisioner.sh" ] || i=-
    echo "provisioner|Provisioner|${i:-?}|$(a=$(provisioner_latest); echo "${a:-?}")"
    i=$(head -1 "$STUMP_RECON_APP/VERSION" 2>/dev/null)
    [ -x "$STUMP_RECON_APP/STUMP-Recon.sh" ] || i=-
    read -r a _ <<<"$(stump_recon_newest)"
    echo "stump-recon|STUMP Recon|${i:-?}|${a:-?}"
}

# ------------------------------------------------------------- updates
sync_repo() {       # a shallow checkout of $1's main branch in $2, brought up to date
    if [ -d "$2/.git" ]; then
        git -C "$2" fetch -q --depth 1 origin main && git -C "$2" reset -q --hard FETCH_HEAD
    else
        rm -rf "$2"; mkdir -p "$(dirname "$2")"
        git clone -q --depth 1 -b main "https://github.com/ruderigo/$1" "$2"
    fi
}
update_firefly() {
    say "FireFly: fetching the main branch of $FIREFLY_REPO..."
    local src="$H/.cache/rk-apps/FireFly-$FIREFLY_SOURCE"
    sync_repo "$FIREFLY_REPO" "$src" || { say "could not fetch FireFly."; return 1; }
    say "FireFly: running its installer..."
    ( cd "$src/firefly" && bash deploy/install.sh ) || { say "FireFly's installer stopped (its message is above)."; return 1; }
    chmod +x "$H/firefly/deploy/"*.sh 2>/dev/null
    say "FireFly is now $(py_version < "$H/firefly/firefly/__init__.py")."
}
update_stump() {
    [ -f "$H/Stump/stump_pc.py" ] || { say "the Stump is not set up yet: open Stump on the dock first."; return 1; }
    local inst="$H/R36MAX-Stump/handheld/install.sh" rc
    # The installer's files first, from the source chosen in AppManager (stable or
    # sandbox). The installer pulls too, but only from wherever its folder
    # was first cloned, and quietly gives up when that pull cannot be a plain
    # fast-forward: AppManager then went on showing a new version that never came.
    clone_stump || return 1
    [ -f "$inst" ] || { say "the Stump's installer is missing from $STUMP_REPO."; return 1; }
    say "Stump: running its installer..."
    if [ -n "${SUDO_ASKPASS:-}" ]; then
        # nobody at a keyboard: an update keeps everything (the RK3326 Provisioner's answers)
        local ans; ans=$(mktemp) && chmod 600 "$ans"
        printf '%s\n' "{\"folder for this stump\": \"$H/Stump\", \"change something\": \"\"," \
            "\"use it for this stump\": false, \"use a heltec over bluetooth instead\": false," \
            "\"fix it, then check again\": false}" > "$ans"
        bash "$inst" --answers "$ans"; rc=$?
        rm -f "$ans"
    else
        bash "$inst"; rc=$?
    fi
    [ "$rc" -eq 0 ] || { say "the Stump's installer stopped (its message is above)."; return 1; }
    say "Stump is now $(head -1 "$H/R36MAX-Stump/handheld/VERSION" 2>/dev/null) ($STUMP_SOURCE)."
}

status() {
    for f in "$H/ports/Ember.sh:Ember" "$H/firefly/deploy/FireFly.sh:FireFly" "$H/R36MAX-Stump/handheld/LaBuche_Stump.sh:Stump" \
             "$PROVISIONER_APP/RK3326_Provisioner.sh:Provisioner" "$STUMP_RECON_APP/STUMP-Recon.sh:STUMP Recon"; do
        p=${f%%:*}; n=${f##*:}
        [ -x "$p" ] && echo "$n installed" || echo "$n absent"
    done
}

cmd=${1:-}; what=${2:-}
case "$cmd" in
    status) status ;;
    install)
        # STUMP Recon installs from the system's own copy: no network needed
        [ "$what" = stump-recon ] || online || { say "not online. Join Wi-Fi first."; exit 1; }
        rc=0
        case "$what" in
            ember) room_for ember && install_ember || rc=1 ;;
            firefly) room_for firefly && install_firefly || rc=1 ;;
            stump) room_for stump && clone_stump || rc=1 ;;
            provisioner) room_for provisioner && install_provisioner || rc=1 ;;
            stump-recon) room_for stump-recon && install_stump_recon || rc=1 ;;
            all) for a in ember firefly stump provisioner stump-recon; do room_for "$a" || rc=1; done
                 [ "$rc" -ne 0 ] || { install_ember || rc=1; install_firefly || rc=1; clone_stump || rc=1; install_provisioner || rc=1; install_stump_recon || rc=1; } ;;
            *) echo "usage: rk-apps install ember|firefly|stump|provisioner|stump-recon|all" >&2; exit 2 ;;
        esac
        exit "$rc" ;;
    versions) versions ;;
    source)
        case "$what" in firefly) key=FIREFLY_SOURCE; cur=$FIREFLY_SOURCE ;; stump) key=STUMP_SOURCE; cur=$STUMP_SOURCE ;;
            *) echo "usage: rk-apps source firefly|stump stable|sandbox" >&2; exit 2 ;; esac
        case "${3:-}" in
            stable|sandbox) set_conf "$key" "$3" && say "$what now comes from: $3" ;;
            "") echo "$cur" ;;
            *) echo "usage: rk-apps source firefly|stump stable|sandbox" >&2; exit 2 ;;
        esac ;;
    update)
        [ "$what" = stump-recon ] || online || { say "not online. Join Wi-Fi first."; exit 1; }
        rc=0
        case "$what" in
            ember) room_for ember && install_ember || rc=1 ;;
            firefly) room_for firefly update && update_firefly || rc=1 ;;
            stump) room_for stump update && update_stump || rc=1 ;;
            provisioner) room_for provisioner update && install_provisioner || rc=1 ;;
            stump-recon) room_for stump-recon update && install_stump_recon || rc=1 ;;
            all) for a in ember firefly stump provisioner stump-recon; do room_for "$a" update || rc=1; done
                 [ "$rc" -ne 0 ] || { install_ember || rc=1; update_firefly || rc=1; update_stump || rc=1; install_provisioner || rc=1; install_stump_recon || rc=1; } ;;
            *) echo "usage: rk-apps update ember|firefly|stump|provisioner|stump-recon|all" >&2; exit 2 ;;
        esac
        exit "$rc" ;;
    *) echo "usage: rk-apps status | versions | install APP | update APP   (APP: ember firefly stump provisioner stump-recon all)" >&2; exit 2 ;;
esac
