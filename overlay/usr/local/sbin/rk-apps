#!/bin/bash
# The dock apps (Ember, FireFly, Stump): fetch them, see their versions,
# update them. Over Wi-Fi, into /home/ark where the dock's launchers look.
#
#   rk-apps status                     what is installed
#   rk-apps versions                   installed and newest version of each
#   rk-apps install ember|firefly|stump|all     (from each one's latest release)
#   rk-apps update ember|firefly|stump|all
#   rk-apps source firefly|stump stable|sandbox  where FireFly/Stump updates come from
#
# An update takes FireFly and the Stump from the main branch of their
# repositories (their GitHub releases lag behind), and Ember from its latest
# release (its binary is only built for releases). Each app's own installer
# does the work, so its data and settings are kept as that installer keeps
# them.
#
# Runs as the ark user. The installers need root for a few steps: over SSH
# sudo asks in the terminal; from the desktop the password comes through
# sudo's askpass helper (SUDO_ASKPASS), which all three installers accept.
set -u
say() { echo "rk-apps: $*"; }
H="${HOME:-/home/ark}"
online() { ip route 2>/dev/null | grep -q '^default'; }

api_asset() {   # print the browser_download_url of the first release asset matching $2 in repo $1
    curl -fsSL "https://api.github.com/repos/$1/releases/latest" |
        python3 -c "import json,sys,re
d=json.load(sys.stdin)
for a in d.get('assets',[]):
    if re.search(sys.argv[1], a['name']): print(a['browser_download_url']); break" "$2"
}

install_ember() {
    say "Fetching Ember (prebuilt arm64)..."
    mkdir -p "$H/ports"
    if curl -fsSL https://github.com/ruderigo/Ember/releases/latest/download/ember-arkos-arm64.tar.gz \
            | tar xz --no-same-owner -C "$H/ports"; then
        chmod +x "$H/ports/Ember.sh" 2>/dev/null
        ember_latest > "$H/ports/ember/.rk-version" 2>/dev/null
        # Ember's launcher runs "sudo chmod 666 /dev/tty1"; on our desktop ark
        # owns tty1, so drop the sudo (it would prompt for a password with no
        # way to answer it).
        sed -i 's/^\( *\)sudo /\1/' "$H/ports/Ember.sh" 2>/dev/null
        say "Ember installed in $H/ports."
    else
        say "could not fetch Ember."; return 1
    fi
}

install_firefly() {
    say "Fetching FireFly..."
    local url; url=$(api_asset ruderigo/FireFly_RK3326_R36MAX_R36S 'FireFly-RK3326-.*\.zip')
    [ -n "$url" ] || { say "could not find a FireFly release asset."; return 1; }
    local tmp; tmp=$(mktemp -d)
    if ! curl -fsSL "$url" -o "$tmp/firefly.zip"; then say "download failed."; rm -rf "$tmp"; return 1; fi
    ( cd "$tmp" && python3 -m zipfile -e firefly.zip . ) || { say "could not unzip FireFly."; rm -rf "$tmp"; return 1; }
    local src; src=$(find "$tmp" -maxdepth 4 -name install.sh -path '*deploy*' | head -1)
    [ -n "$src" ] || { say "no deploy/install.sh in the zip."; rm -rf "$tmp"; return 1; }
    say "Running FireFly's own installer..."
    ( cd "$(dirname "$src")/.." && bash deploy/install.sh ) && say "FireFly installed in $H/firefly." || say "FireFly installer reported a problem (see its output)."
    # python's zipfile does not keep the executable bit, so the dock would see
    # the launcher as not runnable: put it back.
    chmod +x "$H/firefly/deploy/"*.sh 2>/dev/null
    rm -rf "$tmp"
}

clone_stump() {
    say "Fetching Stump ($STUMP_SOURCE) ..."
    local url="https://github.com/ruderigo/$STUMP_REPO"
    if [ -d "$H/R36MAX-Stump/.git" ]; then
        ( cd "$H/R36MAX-Stump" \
          && git remote set-url origin "$url" \
          && git fetch --depth 1 origin main \
          && git reset --hard origin/main ) && say "Stump updated from $STUMP_SOURCE." || { say "could not update Stump."; return 1; }
    elif git clone --depth 1 "$url" "$H/R36MAX-Stump"; then
        say "Stump cloned from $STUMP_SOURCE."
    else
        say "could not fetch Stump."; return 1
    fi
}

# ------------------------------------------------------------ versions
RAW=https://raw.githubusercontent.com/ruderigo
# FireFly and Stump each have two repositories: the published one, and the
# sandbox where new versions land first. "rk-apps source firefly|stump sandbox"
# (or Y in the Apps window) switches; the choice is kept in ~/.config/rk-apps.
CONF="$H/.config/rk-apps"
FIREFLY_SOURCE=stable
STUMP_SOURCE=stable
[ -r "$CONF" ] && . "$CONF"
case "$FIREFLY_SOURCE" in
    sandbox) FIREFLY_REPO=SandBox_FireFly_RK3326 ;;
    *) FIREFLY_SOURCE=stable; FIREFLY_REPO=FireFly_RK3326_R36MAX_R36S ;;
esac
case "$STUMP_SOURCE" in
    sandbox) STUMP_REPO=SandBox_RK3326_Stump ;;
    *) STUMP_SOURCE=stable; STUMP_REPO=R36MAX-Stump ;;
esac

set_conf() {        # set KEY=VALUE in CONF, keeping the other keys
    mkdir -p "$(dirname "$CONF")"
    if [ -f "$CONF" ] && grep -q "^$1=" "$CONF"; then
        sed -i "s#^$1=.*#$1=$2#" "$CONF"
    else
        echo "$1=$2" >> "$CONF"
    fi
}
py_version() { sed -n 's/^__version__ *= *"\([^"]*\)".*/\1/p' | head -1; }
ember_latest() {    # the tag the "latest release" link leads to, without its v
    curl -fsSLI -m 10 -o /dev/null -w '%{url_effective}' https://github.com/ruderigo/Ember/releases/latest 2>/dev/null |
        sed -n 's#.*/tag/v\{0,1\}##p'
}
versions() {        # one line each: id|name|installed|newest|source   ("-" not installed, "?" not known)
    local i a
    i=$(py_version < "$H/firefly/firefly/__init__.py" 2>/dev/null)
    a=$(curl -fsSL -m 10 "$RAW/$FIREFLY_REPO/main/firefly/firefly/__init__.py" 2>/dev/null | py_version)
    [ -x "$H/firefly/deploy/FireFly.sh" ] || i=-
    echo "firefly|FireFly|${i:-?}|${a:-?}|$FIREFLY_SOURCE"
    i=$(head -1 "$H/R36MAX-Stump/handheld/VERSION" 2>/dev/null)
    a=$(curl -fsSL -m 10 "$RAW/$STUMP_REPO/main/handheld/VERSION" 2>/dev/null | head -1)
    [ -f "$H/Stump/stump_pc.py" ] && [ -x "$H/stump_r36max/stump_r36max_engine" ] || i=-
    echo "stump|Stump|${i:-?}|${a:-?}|$STUMP_SOURCE"
    i=$(head -1 "$H/ports/ember/.rk-version" 2>/dev/null)
    [ -x "$H/ports/Ember.sh" ] || i=-
    echo "ember|Ember|${i:-?}|$(a=$(ember_latest); echo "${a:-?}")"
}

# ------------------------------------------------------------- updates
sync_repo() {       # a shallow checkout of $1's main branch in $2, brought up to date
    if [ -d "$2/.git" ]; then
        git -C "$2" fetch -q --depth 1 origin main && git -C "$2" reset -q --hard FETCH_HEAD
    else
        rm -rf "$2"; mkdir -p "$(dirname "$2")"
        git clone -q --depth 1 -b main "https://github.com/ruderigo/$1" "$2"
    fi
}
update_firefly() {
    say "FireFly: fetching the main branch of $FIREFLY_REPO..."
    local src="$H/.cache/rk-apps/FireFly-$FIREFLY_SOURCE"
    sync_repo "$FIREFLY_REPO" "$src" || { say "could not fetch FireFly."; return 1; }
    say "FireFly: running its installer..."
    ( cd "$src/firefly" && bash deploy/install.sh ) || { say "FireFly's installer stopped (its message is above)."; return 1; }
    chmod +x "$H/firefly/deploy/"*.sh 2>/dev/null
    say "FireFly is now $(py_version < "$H/firefly/firefly/__init__.py")."
}
update_stump() {
    [ -f "$H/Stump/stump_pc.py" ] || { say "the Stump is not set up yet: open Stump on the dock first."; return 1; }
    local inst="$H/R36MAX-Stump/handheld/install.sh" rc
    say "Stump: running its installer (it fetches its own updates)..."
    if [ -n "${SUDO_ASKPASS:-}" ]; then
        # nobody at a keyboard: an update keeps everything (the RK3326 Provisioner's answers)
        local ans; ans=$(mktemp) && chmod 600 "$ans"
        printf '%s\n' "{\"folder for this stump\": \"$H/Stump\", \"change something\": \"\"," \
            "\"use it for this stump\": false, \"use a heltec over bluetooth instead\": false," \
            "\"fix it, then check again\": false}" > "$ans"
        bash "$inst" --answers "$ans"; rc=$?
        rm -f "$ans"
    else
        bash "$inst"; rc=$?
    fi
    [ "$rc" -eq 0 ] || { say "the Stump's installer stopped (its message is above)."; return 1; }
    say "Stump is now $(head -1 "$H/R36MAX-Stump/handheld/VERSION" 2>/dev/null) ($STUMP_SOURCE)."
}

status() {
    for f in "$H/ports/Ember.sh:Ember" "$H/firefly/deploy/FireFly.sh:FireFly" "$H/R36MAX-Stump/handheld/LaBuche_Stump.sh:Stump"; do
        p=${f%%:*}; n=${f##*:}
        [ -x "$p" ] && echo "$n installed" || echo "$n absent"
    done
}

cmd=${1:-}; what=${2:-}
case "$cmd" in
    status) status ;;
    install)
        online || { say "not online. Join Wi-Fi first."; exit 1; }
        rc=0
        case "$what" in
            ember) install_ember || rc=1 ;;
            firefly) install_firefly || rc=1 ;;
            stump) clone_stump || rc=1 ;;
            all) install_ember || rc=1; install_firefly || rc=1; clone_stump || rc=1 ;;
            *) echo "usage: rk-apps install ember|firefly|stump|all" >&2; exit 2 ;;
        esac
        exit "$rc" ;;
    versions) versions ;;
    source)
        case "$what" in firefly) key=FIREFLY_SOURCE; cur=$FIREFLY_SOURCE ;; stump) key=STUMP_SOURCE; cur=$STUMP_SOURCE ;;
            *) echo "usage: rk-apps source firefly|stump stable|sandbox" >&2; exit 2 ;; esac
        case "${3:-}" in
            stable|sandbox) set_conf "$key" "$3" && say "$what now comes from: $3" ;;
            "") echo "$cur" ;;
            *) echo "usage: rk-apps source firefly|stump stable|sandbox" >&2; exit 2 ;;
        esac ;;
    update)
        online || { say "not online. Join Wi-Fi first."; exit 1; }
        rc=0
        case "$what" in
            ember) install_ember || rc=1 ;;
            firefly) update_firefly || rc=1 ;;
            stump) update_stump || rc=1 ;;
            all) install_ember || rc=1; update_firefly || rc=1; update_stump || rc=1 ;;
            *) echo "usage: rk-apps update ember|firefly|stump|all" >&2; exit 2 ;;
        esac
        exit "$rc" ;;
    *) echo "usage: rk-apps status | versions | install APP | update APP   (APP: ember firefly stump all)" >&2; exit 2 ;;
esac
