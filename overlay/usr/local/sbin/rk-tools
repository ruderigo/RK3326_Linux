#!/bin/bash
# The heavy tools, fetched on first online boot so the flashed image stays
# small. Metasploit alone is about a gigabyte with its Ruby stack, so it is
# not baked in; this pulls it over Wi-Fi when you ask.
#
#   rk-tools status         whether online, and what heavy tool is installed
#   rk-tools install-heavy   install Metasploit and exploitdb (needs network)
#   rk-tools links           put back missing links to the tools on the data partition (every start)
#   rk-tools install-media   install what Video and Games need (mpv, QuickJS,
#                            and the emulator bundle: RetroArch and its cores),
#                            on a card flashed before they were part of the image
#
# For testing machines that are yours, or that you have been asked to test.
set -u
say() { echo "rk-tools: $*"; }
have() { command -v "$1" >/dev/null 2>&1; }
EMU_DIR="${RK_EMU_DIR:-/opt/rk-emulators}"          # RK_EMU_*: for the tests
have_retroarch() { [ -x "$EMU_DIR/bin/retroarch" ]; }
online() { ip route 2>/dev/null | grep -q '^default'; }

HEAVY_DIR="${RK_HEAVY_DIR:-/data/opt}"            # RK_HEAVY_DIR, RK_BIN_DIR: for the tests
BIN_DIR="${RK_BIN_DIR:-/usr/local/bin}"

# the checks made before anything is fetched: room, memory (see the file)
RK_WHO=rk-tools
. "${RK_LIB:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../lib/rk}/preflight.sh"

# Fully installed, not merely known to dpkg: a package whose install was cut
# short (power, a restart) is unpacked but not set up, and does not count.
installed() { [ "$(dpkg-query -W -f='${Status}' "$1" 2>/dev/null)" = "install ok installed" ]; }

# Only one program may install packages at a time. Debian itself refreshes
# its package lists in the background (after a start, once a day), and the
# desktop may be running another install: wait for it instead of failing.
RK_APT_CACHE=$(rk_apt_cache)                 # downloads go to the data partition when there is one
APT="apt-get -o DPkg::Lock::Timeout=600 -o Dir::Cache::archives=$RK_APT_CACHE"
lock_free() {
    python3 -I -c "import fcntl,sys
for p in ('/var/lib/dpkg/lock-frontend', '/var/lib/dpkg/lock'):
    try:
        f = open(p, 'a')
        fcntl.lockf(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except FileNotFoundError:
        continue
    except OSError:
        sys.exit(1)"
}
wait_lock() {
    local n=0
    lock_free && return 0
    say "another install or update is running; waiting for it (up to 10 minutes)..."
    while ! lock_free; do
        n=$((n + 1))
        [ "$n" -lt 120 ] || { say "it is still running. Try again when it has finished."; return 1; }
        sleep 5
    done
    say "it has finished."
}

free_mb() { rk_free_mb "${1:-/}"; }

# Debian's RetroArch was installed by an earlier version of this setup. It
# cannot draw on this panel, and it brings the Qt desktop libraries and 100 MB
# of menu pictures with it. Games uses the emulator bundle instead: take
# Debian's away, whatever state it was left in, with what only it needed.
drop_debian_retroarch() {
    local st
    st=$(dpkg-query -W -f='${db:Status-Abbrev}' retroarch 2>/dev/null | cut -c1-2)
    case "$st" in ""|un|pn) return 0 ;; esac
    say "removing Debian's RetroArch (not used here; Games has its own)..."
    dpkg --purge --force-remove-reinstreq retroarch || { say "could not remove it (see above)."; return 1; }
    DEBIAN_FRONTEND=noninteractive $APT purge -y -q retroarch-assets 'libretro-*' >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive $APT autoremove --purge -y -q || true
    say "removed; $(free_mb /) MB free on the system partition."
}

# An install that was cut short leaves dpkg refusing every later one until it
# is finished. Finish it first; nothing to do when the last one ended well.
repair() {
    wait_lock || return 1
    if [ -n "$(ls /var/lib/dpkg/updates 2>/dev/null)" ] || dpkg --audit 2>/dev/null | grep -q .; then
        say "an earlier install was interrupted: finishing it first..."
        # Two steps, and the first may fail on its own: a package can be
        # unpacked while one it depends on never arrived. The second step
        # fetches what is missing and sets up the rest.
        DEBIAN_FRONTEND=noninteractive dpkg --configure -a || say "some packages wait for others; fetching those..."
        if ! DEBIAN_FRONTEND=noninteractive $APT install -f -y -q --no-install-recommends; then
            say "could not finish the earlier install (see above)."; return 1
        fi
        if dpkg --audit 2>/dev/null | grep -q .; then
            say "packages are still half-installed (see above)."; return 1
        fi
        say "the earlier install is finished."
    fi
}

status() {
    online && echo "online yes" || echo "online no"
    have mpv && echo "mpv installed" || echo "mpv absent"
    have_retroarch && echo "retroarch installed" || echo "retroarch absent"
    have msfconsole && echo "metasploit installed" || echo "metasploit absent"
    { have searchsploit || [ -x "$BIN_DIR/searchsploit" ]; } &&
        echo "exploitdb installed" || echo "exploitdb absent"
}

install_msf() {
    have msfconsole && { say "Metasploit is already installed"; return 0; }
    local msf_on_data=
    say "Fetching Metasploit (large; this takes a while)..."
    install -d -m 0755 /etc/apt/keyrings
    # apt reads an armoured key straight from signed-by, so no gpg needed here
    if ! curl -fsSL https://apt.metasploit.com/metasploit-framework.gpg.key \
            -o /etc/apt/keyrings/metasploit.asc; then
        say "could not fetch the Metasploit signing key - are you online?"; return 1
    fi
    local arch; arch=$(dpkg --print-architecture)
    echo "deb [signed-by=/etc/apt/keyrings/metasploit.asc] https://apt.metasploit.com/ lucid main" \
        > /etc/apt/sources.list.d/metasploit.list
    $APT update -q || { say "could not reach the Metasploit repo"; rm -f /etc/apt/sources.list.d/metasploit.list; return 1; }
    # Room and memory, from the package's own sizes, before the download starts.
    # Metasploit unpacks under /opt/metasploit-framework: when the system
    # partition cannot hold it and the data partition can, it goes there
    # (the folder is made a link first, and dpkg follows it).
    if ! rk_need_apt "Metasploit" metasploit-framework >/dev/null 2>&1 && mountpoint -q /data 2>/dev/null &&
            [ ! -e /opt/metasploit-framework ]; then
        local cost inst
        cost=$(rk_apt_cost metasploit-framework) && read -r _ inst <<<"$cost"
        if [ -n "${inst:-}" ] && rk_need_space $(( inst + 64 )) "$HEAVY_DIR" "Metasploit"; then
            install -d -m 0755 "$HEAVY_DIR/metasploit-framework" /opt
            ln -s "$HEAVY_DIR/metasploit-framework" /opt/metasploit-framework
            say "the system partition is too full for Metasploit: putting it on the data partition."
            msf_on_data=1
        fi
    fi
    if [ -z "${msf_on_data:-}" ] && ! rk_need_apt "Metasploit" metasploit-framework; then
        rm -f /etc/apt/sources.list.d/metasploit.list; $APT update -q >/dev/null 2>&1 || true
        return 1
    fi
    if ! rk_need_mem 120 "installing Metasploit"; then
        rm -f /etc/apt/sources.list.d/metasploit.list; $APT update -q >/dev/null 2>&1 || true
        return 1
    fi
    if ! $APT install -y -q metasploit-framework; then
        [ -z "${msf_on_data:-}" ] || { rm -f /opt/metasploit-framework; rm -rf "$HEAVY_DIR/metasploit-framework"; }
        say "the Metasploit repo has no build for $arch."
        say "On $arch, install it from the Kali repo by hand (see docs/arsenal.md)."
        say "Nothing was left half-installed."
        rm -f /etc/apt/sources.list.d/metasploit.list
        $APT update -q >/dev/null 2>&1 || true
        return 1
    fi
    say "Metasploit installed."
}

# The heavy tools live on the data partition, and are reached through links
# on the system partition. The data partition outlives the system (a reflash,
# a restored backup); the links do not. This puts back any that is missing:
# without it the tool was on the card, "already installed" to this script,
# and absent to the Arsenal and the Terminal, which look for the command.
relink() {
    local changed=0
    if [ -x "$HEAVY_DIR/exploitdb/searchsploit" ] &&
            [ "$(readlink "$BIN_DIR/searchsploit" 2>/dev/null)" != "$HEAVY_DIR/exploitdb/searchsploit" ]; then
        mkdir -p "$BIN_DIR" && ln -sfn "$HEAVY_DIR/exploitdb/searchsploit" "$BIN_DIR/searchsploit" && changed=1
    fi
    if [ -z "${RK_EMU_DIR:-}" ] && [ -x "$HEAVY_DIR/rk-emulators/bin/retroarch" ] && [ ! -e "$EMU_DIR" ]; then
        ln -sfn "$HEAVY_DIR/rk-emulators" "$EMU_DIR" && changed=1
    fi
    [ "$changed" -eq 0 ] || say "put back the links to the tools on the data partition."
    return 0
}

install_exploitdb() {
    relink
    if have searchsploit || [ -x "$BIN_DIR/searchsploit" ]; then
        say "exploitdb is already installed"; return 0
    fi
    install -d -m 0755 "$HEAVY_DIR"
    rk_need_space 500 "$HEAVY_DIR" "exploitdb" || return 1
    say "Fetching exploitdb..."
    rm -rf "$HEAVY_DIR/exploitdb"               # a fetch that was cut short: start again
    if git clone --depth 1 https://gitlab.com/exploit-database/exploitdb.git "$HEAVY_DIR/exploitdb"; then
        relink
        say "exploitdb installed in $HEAVY_DIR/exploitdb."
    else
        say "could not fetch exploitdb (needs network)."; return 1
    fi
}

# Video: the same names as build/packages-media.txt, which a new image
# installs when it is built.
MEDIA_PKGS="mpv quickjs libpng16-16t64"

# Games: the emulator bundle (RetroArch built for this GPU, and its cores),
# made by build/build-emulators.sh. It is inside every image, and each
# release of the system also carries it as a file, rk-emulators-<n>.tar.xz;
# a card flashed before Games existed takes it from there. Which <n> this
# system wants is in /usr/share/rk/emulators.bundle.
EMU_REPO=ruderigo/RK3326_Linux

# The address of a release file by its name: the newest release (pre-releases
# count) of this repository that has it. Nothing printed when none has.
release_asset() {
    curl -fsSL -m 30 "https://api.github.com/repos/$EMU_REPO/releases?per_page=30" 2>/dev/null |
        python3 -I -c "import json,sys
try: rels=json.load(sys.stdin)
except Exception: sys.exit(0)
for r in rels if isinstance(rels, list) else []:
    for a in r.get('assets', []):
        if a.get('name') == sys.argv[1]:
            print(a['browser_download_url']); sys.exit(0)" "$1"
}

# Unpack the bundle's opt/rk-emulators/ into a folder. With Python, which
# reads .tar.xz itself: the image has no xz program, and tar needs one. Only
# what is under opt/rk-emulators/ is accepted; anything else refuses the lot.
unpack_emulators() {    # unpack_emulators ARCHIVE DEST
    python3 -I - "$1" "$2" <<'PY'
import sys, tarfile
src, dest = sys.argv[1:3]
top = "opt/rk-emulators"
try:
    with tarfile.open(src, "r:xz") as t:
        keep = []
        for m in t.getmembers():
            name = m.name
            while name.startswith("./"):
                name = name[2:]
            name = name.rstrip("/")
            if name in ("", "opt", top):
                continue
            if not name.startswith(top + "/"):
                sys.exit(f"rk-tools: the archive holds {m.name!r}, outside /{top}; nothing changed.")
            m.name = name[len(top) + 1:]
            keep.append(m)
        if not keep:
            sys.exit("rk-tools: the archive is empty.")
        t.extractall(dest, members=keep, filter="data")     # "data": no links or paths that leave dest
except (tarfile.TarError, OSError, EOFError) as e:
    sys.exit(f"rk-tools: {e}")
PY
}

install_emulators() {
    local n have_n name url tmp want got
    n=$(head -1 "${RK_EMU_WANT:-/usr/share/rk/emulators.bundle}" 2>/dev/null | tr -cd '0-9')
    [ -n "$n" ] || { say "this system does not say which emulator bundle it wants."; return 1; }
    have_n=$(sed -n 's/^bundle //p' "$EMU_DIR/VERSION" 2>/dev/null | head -1)
    if have_retroarch && [ "$have_n" = "$n" ]; then
        say "the emulators are already installed (bundle $n)"; return 0
    fi
    name="rk-emulators-$n.tar.xz"
    if [ -n "${RK_EMU_BASE:-}" ]; then
        url="$RK_EMU_BASE/$name"
    else
        url=$(release_asset "$name")
        if [ -z "$url" ] && have_retroarch; then
            say "bundle $n of the emulators is not published yet; keeping bundle ${have_n:-?}, which works as before."
            return 0
        fi
        [ -n "$url" ] || { say "no release of the system carries $name yet."; return 1; }
    fi
    tmp=$(rk_tmpdir rk-emu) || return 1
    rk_need_space 40 "$tmp" "the emulators' download" || { rm -rf "$tmp"; return 1; }
    say "fetching the emulators (bundle $n, about 15 MB)..."
    if ! curl -fsSL "$url.sha256" -o "$tmp/sum" || ! curl -fsSL "$url" -o "$tmp/$name"; then
        say "could not fetch $name."; rm -rf "$tmp"; return 1
    fi
    want=$(awk '{print $1; exit}' "$tmp/sum"); got=$(sha256sum "$tmp/$name" | cut -d' ' -f1)
    if [ -z "$want" ] || [ "$want" != "$got" ]; then
        say "the download does not match its checksum; nothing changed."; rm -rf "$tmp"; return 1
    fi
    # On a handheld the bundle lives on the data partition, which has the
    # room (the system partition of an older card is small), and
    # /opt/rk-emulators points to it.
    local target="$EMU_DIR"
    if [ -z "${RK_EMU_DIR:-}" ] && mountpoint -q /data 2>/dev/null; then
        target="$HEAVY_DIR/rk-emulators"
    fi
    install -d -m 0755 "$(dirname "$target")"
    rk_need_space 200 "$(dirname "$target")" "the emulators" || { rm -rf "$tmp"; return 1; }
    rm -rf "$target.new" && mkdir -p "$target.new" && unpack_emulators "$tmp/$name" "$target.new" || {
            say "could not unpack the emulators."; rm -rf "$tmp" "$target.new"; return 1; }
    rm -rf "$tmp" "$target.old"
    [ ! -d "$target" ] || mv "$target" "$target.old"
    mv "$target.new" "$target" && rm -rf "$target.old"
    chown -R 0:0 "$target"
    if [ "$target" != "$EMU_DIR" ]; then
        [ -L "$EMU_DIR" ] || rm -rf "$EMU_DIR"
        ln -sfn "$target" "$EMU_DIR"
    fi
    say "the emulators are installed (bundle $n)."
}

install_media() {
    local p rc=0
    wait_lock || return 1
    drop_debian_retroarch || return 1
    repair || return 1
    local todo=
    for p in $MEDIA_PKGS; do installed "$p" || todo="$todo $p"; done
    if [ -n "$todo" ]; then
        $APT clean >/dev/null 2>&1 || true          # packages already installed: room for nothing
        $APT update -q || { say "could not reach Debian's package servers"; return 1; }
        rk_need_apt "the video player" $todo || return 1
        rk_need_mem 60 "installing the video player" || return 1
    fi
    for p in $MEDIA_PKGS; do
        if installed "$p"; then
            say "$p is already installed"
        elif DEBIAN_FRONTEND=noninteractive $APT install -y -q --no-install-recommends "$p"; then
            say "$p installed"
        else
            say "$p could not be installed"; rc=1
        fi
    done
    have mpv || { say "mpv is missing: Video cannot play."; rc=1; }
    # Games does not hold Video back: say so, and carry on
    install_emulators || { say "Games is not ready yet (see above); Video does not need it."; }
    return "$rc"
}

case "${1:-}" in
    status) status ;;
    links)  [ "$(id -u)" -eq 0 ] || { echo "rk-tools: run as root" >&2; exit 1; }; relink ;;
    install-emulators)
        install_emulators; exit $? ;;
    install-media)
        online || { say "not online. Join Wi-Fi first, then try again."; exit 1; }
        rc=0
        install_media || rc=1
        $APT clean >/dev/null 2>&1 || true
        [ "$rc" -eq 0 ] && say "done." || say "finished; something was not installed (see above)."
        exit "$rc" ;;
    install-heavy)
        online || { say "not online. Join Wi-Fi first, then try again."; exit 1; }
        repair || exit 1
        $APT clean >/dev/null 2>&1 || true
        rc=0
        install_msf || rc=1
        install_exploitdb || rc=1
        $APT clean >/dev/null 2>&1 || true
        [ "$rc" -eq 0 ] && say "done." || say "finished; some tools were not installed (see above)."
        exit "$rc" ;;
    *) echo "usage: rk-tools status | install-heavy | install-media | install-emulators" >&2; exit 2 ;;
esac
