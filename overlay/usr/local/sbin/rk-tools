#!/bin/bash
# The heavy tools, fetched on first online boot so the flashed image stays
# small. Metasploit alone is about a gigabyte with its Ruby stack, so it is
# not baked in; this pulls it over Wi-Fi when you ask.
#
#   rk-tools status         whether online, and what heavy tool is installed
#   rk-tools install-heavy   install Metasploit and exploitdb (needs network)
#   rk-tools install-media   install what Video and Games need (mpv, QuickJS,
#                            RetroArch and its cores), on a card flashed before
#                            they were part of the image
#
# For testing machines that are yours, or that you have been asked to test.
set -u
say() { echo "rk-tools: $*"; }
have() { command -v "$1" >/dev/null 2>&1; }
have_retroarch() { have retroarch || [ -x /usr/games/retroarch ]; }   # Debian keeps games in /usr/games
online() { ip route 2>/dev/null | grep -q '^default'; }

HEAVY_DIR=/data/opt

# Fully installed, not merely known to dpkg: a package whose install was cut
# short (power, a restart) is unpacked but not set up, and does not count.
installed() { [ "$(dpkg-query -W -f='${Status}' "$1" 2>/dev/null)" = "install ok installed" ]; }

# An install that was cut short leaves dpkg refusing every later one until it
# is finished. Finish it first; nothing to do when the last one ended well.
repair() {
    if [ -n "$(ls /var/lib/dpkg/updates 2>/dev/null)" ] || dpkg --audit 2>/dev/null | grep -q .; then
        say "an earlier install was interrupted: finishing it first..."
        if ! DEBIAN_FRONTEND=noninteractive dpkg --configure -a; then
            say "could not finish the earlier install (see above)."; return 1
        fi
        DEBIAN_FRONTEND=noninteractive apt-get install -f -y -q || true
    fi
}

status() {
    online && echo "online yes" || echo "online no"
    have mpv && echo "mpv installed" || echo "mpv absent"
    have_retroarch && echo "retroarch installed" || echo "retroarch absent"
    have msfconsole && echo "metasploit installed" || echo "metasploit absent"
    { have searchsploit || [ -x "$HEAVY_DIR/exploitdb/searchsploit" ]; } &&
        echo "exploitdb installed" || echo "exploitdb absent"
}

install_msf() {
    have msfconsole && { say "Metasploit is already installed"; return 0; }
    say "Fetching Metasploit (large; this takes a while)..."
    install -d -m 0755 /etc/apt/keyrings
    # apt reads an armoured key straight from signed-by, so no gpg needed here
    if ! curl -fsSL https://apt.metasploit.com/metasploit-framework.gpg.key \
            -o /etc/apt/keyrings/metasploit.asc; then
        say "could not fetch the Metasploit signing key - are you online?"; return 1
    fi
    local arch; arch=$(dpkg --print-architecture)
    echo "deb [signed-by=/etc/apt/keyrings/metasploit.asc] https://apt.metasploit.com/ lucid main" \
        > /etc/apt/sources.list.d/metasploit.list
    apt-get update -q || { say "could not reach the Metasploit repo"; return 1; }
    if ! apt-get install -y -q metasploit-framework; then
        say "the Metasploit repo has no build for $arch."
        say "On $arch, install it from the Kali repo by hand (see docs/arsenal.md)."
        say "Nothing was left half-installed."
        rm -f /etc/apt/sources.list.d/metasploit.list
        apt-get update -q >/dev/null 2>&1 || true
        return 1
    fi
    say "Metasploit installed."
}

install_exploitdb() {
    if have searchsploit || [ -x "$HEAVY_DIR/exploitdb/searchsploit" ]; then
        say "exploitdb is already installed"; return 0
    fi
    say "Fetching exploitdb..."
    install -d -m 0755 "$HEAVY_DIR"
    if git clone --depth 1 https://gitlab.com/exploit-database/exploitdb.git "$HEAVY_DIR/exploitdb"; then
        ln -sf "$HEAVY_DIR/exploitdb/searchsploit" /usr/local/bin/searchsploit
        say "exploitdb installed in $HEAVY_DIR/exploitdb."
    else
        say "could not fetch exploitdb (needs network)."; return 1
    fi
}

# Video and Games: the same names as build/packages-media.txt, which a new
# image installs when it is built.
MEDIA_PKGS="mpv quickjs retroarch libretro-nestopia libretro-snes9x libretro-gambatte libretro-mgba libretro-genesisplusgx libretro-beetle-pce-fast"

install_media() {
    local p missing=
    repair || return 1
    apt-get update -q || { say "could not reach Debian's package servers"; return 1; }
    for p in $MEDIA_PKGS; do
        if installed "$p"; then
            say "$p is already installed"
        elif DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends "$p"; then
            say "$p installed"
        else
            say "$p could not be installed"; missing="$missing $p"
        fi
    done
    have mpv || { say "mpv is missing: Video cannot play."; return 1; }
    have_retroarch || { say "RetroArch is missing: Games cannot start."; return 1; }
    [ -z "$missing" ] || say "left out:$missing"
}

case "${1:-}" in
    status) status ;;
    install-media)
        online || { say "not online. Join Wi-Fi first, then try again."; exit 1; }
        rc=0
        install_media || rc=1
        apt-get clean >/dev/null 2>&1 || true
        [ "$rc" -eq 0 ] && say "done." || say "finished; something was not installed (see above)."
        exit "$rc" ;;
    install-heavy)
        online || { say "not online. Join Wi-Fi first, then try again."; exit 1; }
        repair || exit 1
        rc=0
        install_msf || rc=1
        install_exploitdb || rc=1
        apt-get clean >/dev/null 2>&1 || true
        [ "$rc" -eq 0 ] && say "done." || say "finished; some tools were not installed (see above)."
        exit "$rc" ;;
    *) echo "usage: rk-tools status | install-heavy | install-media" >&2; exit 2 ;;
esac
