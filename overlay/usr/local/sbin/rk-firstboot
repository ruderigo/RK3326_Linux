#!/bin/bash
# First start of a freshly flashed card: make this card's own SSH host keys
# and set up the data partition. Runs once (rk-firstboot.service).
#
# The data partition (label RKDATA, mounted on /data) fills the rest of the
# card after the system. Flashing a new image rewrites the partition table
# without it, but leaves its contents alone: when a card is flashed again the
# partition is put back at the same place and, if a RKDATA filesystem is
# already there, it is kept as it is.
#
# After /data comes the partition a computer can read (exFAT, label RKSHARE,
# mounted on /share): rk-share makes it, or puts it back, here too. /data is
# 16 GiB and the visible partition takes the rest; see rk-share.
set -u
log() { echo "rk-firstboot: $*"; }
FSTAB=/etc/fstab
FSTAB_DATA='LABEL=RKDATA    /data  ext4  defaults,noatime,nofail,x-systemd.device-timeout=8s 0 2'

[ -f /etc/ssh/ssh_host_ed25519_key ] || { ssh-keygen -A && log "SSH host keys made"; }

# The card is the disk the kernel was told to start from (root=/dev/mmcblk0p2).
# Without a ramdisk, findmnt can show "/dev/root" there, so read the command line.
root=$(sed -n 's/.*\broot=\([^ ]*\).*/\1/p' /proc/cmdline)
case $root in /dev/*) ;; *) root=$(findmnt -n -o SOURCE /) ;; esac
disk=/dev/$(lsblk -n -o PKNAME "$root" 2>/dev/null | head -n 1)
part="${disk}p3"
if [ -b "$disk" ] && [ "$disk" != /dev/ ]; then
    # rk-data-partition places partition 3 after the system and refuses any
    # other place: the space before partition 1 holds the boot chain.
    if /usr/local/sbin/rk-data-partition "$disk"; then
        [ -b "$part" ] || { partx -a -n 3 "$disk" 2>/dev/null || partprobe "$disk" 2>/dev/null; }
        udevadm settle --timeout=10
        share=1
        if [ ! -b "$part" ]; then
            log "partition 3 did not appear; /data stays on the system partition"
        else
            # the visible partition first: it sets the size of partition 3
            # (and, on a card whose /data filled it, makes /data smaller)
            /usr/local/sbin/rk-share convert "$disk"; share=$?
            if [ "$(blkid -p -s TYPE -o value "$part" 2>/dev/null)" = ext4 ] &&
               [ "$(blkid -p -s LABEL -o value "$part" 2>/dev/null)" = RKDATA ]; then
                log "kept the existing data partition"
            else
                # the size is given, from the table: the kernel may still
                # hold the size partition 3 had before the visible one
                n3=$(sfdisk -d "$disk" 2>/dev/null | grep ' : start=' | sed -n 3p | sed -n 's/.*size= *\([0-9]*\).*/\1/p')
                mkfs.ext4 -q -F -L RKDATA -O ^orphan_file,^metadata_csum_seed "$part" ${n3:+$(( n3 / 2 ))k} && log "made the data partition"
            fi
        fi
        udevadm settle --timeout=10
        mkdir -p /data
        if [ -b "$part" ] && [ "$(blkid -s LABEL -o value "$part" 2>/dev/null)" = RKDATA ]; then
            # The image has no /etc/fstab line for /data (the partition is
            # only made here), so later starts mount it from this one.
            grep -q '^LABEL=RKDATA[[:space:]]' "$FSTAB" ||
                echo "$FSTAB_DATA" >> "$FSTAB"
            mountpoint -q /data || mount /data || log "could not mount /data"
            mountpoint -q /data && { mkdir -p /data/ark; chown ark:ark /data/ark; }
        fi
        case $share in
            0) /usr/local/sbin/rk-share adopt || log "the visible partition is made but not set up yet" ;;
            # 4: no room on this card, 5: /data holds too much. Otherwise the
            # partition is in the table and not formatted yet (the kernel has
            # to read the table again): the next start finishes it
            4|5) ;;
            *) [ -f /var/lib/rk/share-format ] && : > /var/lib/rk/share-requested ;;
        esac
    else
        log "no data partition made; /data stays on the system partition"
    fi
else
    log "could not find the card's device from $root"
fi

mkdir -p /var/lib/rk && date -u +%FT%TZ > /var/lib/rk/firstboot-done
exit 0
