#!/usr/bin/python3
"""Network scans for the desktop, as root, and only of the handheld's own network.

  rk-scan networks          the networks this handheld is on, one per line
  rk-scan hosts <network>   which addresses answer (nmap -sn), as nmap XML
  rk-scan ports <address>   the common open ports of one address (nmap -F), as nmap XML

Root is needed for the quick, reliable kind of scan (ARP on the local
network). So that the desktop's permission to run this is not a permission to
scan anything anywhere, the target has to lie inside a network one of the
handheld's own interfaces is on, and a network larger than 1024 addresses is
refused. Scanning other targets is a deliberate act, with nmap in a terminal.
"""
import ipaddress
import json
import subprocess
import sys


def own_networks():
    out = subprocess.run(["ip", "-j", "-4", "addr", "show", "scope", "global"], capture_output=True, text=True).stdout
    nets = []
    for dev in json.loads(out or "[]"):
        for a in dev.get("addr_info", []):
            if a.get("family") == "inet":
                iface = ipaddress.ip_interface(f"{a['local']}/{a['prefixlen']}")
                nets.append((dev["ifname"], iface))
    return nets


def die(msg):
    print("rk-scan: " + msg, file=sys.stderr)
    sys.exit(2)


def main():
    if len(sys.argv) == 2 and sys.argv[1] == "networks":
        for ifname, iface in own_networks():
            print(f"{ifname} {iface.network} {iface.ip}")
        return 0
    if len(sys.argv) != 3 or sys.argv[1] not in ("hosts", "ports"):
        die("usage: rk-scan networks | hosts <network> | ports <address>")
    mine = [iface.network for _, iface in own_networks()]
    try:
        if sys.argv[1] == "hosts":
            target = ipaddress.ip_network(sys.argv[2], strict=True)
            if target.num_addresses > 1024:
                die(f"{target} is larger than 1024 addresses")
            inside = any(target.subnet_of(n) for n in mine)
        else:
            target = ipaddress.ip_address(sys.argv[2])
            inside = any(target in n for n in mine)
    except ValueError as e:
        die(str(e))
    if not inside:
        die(f"{target} is not on a network this handheld is connected to")
    if sys.argv[1] == "hosts":
        cmd = ["nmap", "-sn", "-T4", "-oX", "-", str(target)]
    else:
        cmd = ["nmap", "-F", "-T4", "--open", "-oX", "-", str(target)]
    return subprocess.run(cmd).returncode


if __name__ == "__main__":
    sys.exit(main())
