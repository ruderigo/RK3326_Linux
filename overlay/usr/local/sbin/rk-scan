#!/usr/bin/python3
"""Run a scan for the desktop, as root.

  rk-scan networks      the networks this handheld is on, one per line (no root needed)
  rk-scan run           run the scan described on the first line of standard input
                        (a JSON loadout, see rkshell/nmapspec.py); nmap's XML, with
                        its progress, comes out on standard output

SYN and UDP scans and the OS guess need root, so the desktop is allowed to
run this through sudo. The nmap command is built here from the loadout by
rkshell.nmapspec, the same code that shows the command on screen: a target
cannot carry an option of nmap's own, so this is not a way to make root
write a file or run a script.

To stop a scan, close this program's standard input: a root process cannot
be signalled by the user who started it, so that is how the desktop cancels.
"""
import ipaddress
import json
import subprocess
import sys
import threading

from rkshell import nmapspec


def networks():
    out = subprocess.run(["ip", "-j", "-4", "addr", "show", "scope", "global"], capture_output=True, text=True).stdout
    for dev in json.loads(out or "[]"):
        for a in dev.get("addr_info", []):
            if a.get("family") == "inet":
                iface = ipaddress.ip_interface(f"{a['local']}/{a['prefixlen']}")
                print(f"{dev['ifname']} {iface.network} {iface.ip}")
    return 0


def run():
    try:
        spec = json.loads(sys.stdin.readline())
    except ValueError:
        print("rk-scan: the loadout is not valid JSON", file=sys.stderr)
        return 2
    if not isinstance(spec, dict) or nmapspec.problem(spec):
        print("rk-scan: " + (nmapspec.problem(spec) if isinstance(spec, dict) else "the loadout is not a table"), file=sys.stderr)
        return 2
    cmd = nmapspec.command(spec)
    cmd[1:1] = ["-oX", "-", "--stats-every", "2s"]
    nmap = subprocess.Popen(cmd, stdin=subprocess.DEVNULL)

    def watch():                        # standard input closed: the desktop cancelled
        sys.stdin.read()
        if nmap.poll() is None:
            nmap.terminate()
    threading.Thread(target=watch, daemon=True).start()
    return nmap.wait()


if __name__ == "__main__":
    if sys.argv[1:] == ["networks"]:
        sys.exit(networks())
    if sys.argv[1:] == ["run"]:
        sys.exit(run())
    print("usage: rk-scan networks | run", file=sys.stderr)
    sys.exit(2)
