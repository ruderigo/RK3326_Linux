{
 "name": "Games",
 "icon": "games",
 "group": "Play",
 "about": "RetroArch, for your own game files",
 "exec": [
  "/opt/rk-emulators/bin/retroarch",
  "--appendconfig",
  "/usr/share/rk/retroarch/rk.cfg"
 ],
 "before": [
  "/usr/local/bin/rk-games",
  "prepare"
 ],
 "mouse": false,
 "after": [
  "/usr/local/bin/rk-games",
  "done"
 ]
}
