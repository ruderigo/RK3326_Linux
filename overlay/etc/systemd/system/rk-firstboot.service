[Unit]
Description=First start: SSH host keys and the data partition
ConditionPathExists=!/var/lib/rk/firstboot-done
After=systemd-remount-fs.service systemd-udevd.service
Before=ssh.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/rk-firstboot
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
