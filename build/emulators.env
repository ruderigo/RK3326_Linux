# What the emulator bundle is made of. Raise a pin on purpose, then try the
# bundle on a handheld.

# RetroArch, built from source for this GPU (the version dArkOS builds)
RETROARCH_REPO=https://github.com/libretro/RetroArch
RETROARCH_TAG=v1.22.2

# Cores built for the RK3326 by the dArkOS project, taken as they are
CORES_REPO=https://github.com/christianhaitian/retroarch-cores
CORES_COMMIT=f32c6189d6e1bf6565bfdbbf552db2c5c931098d
# PlayStation; Nintendo 64 (two, because neither runs every game); PSP; then
# the 8- and 16-bit machines and the Game Boys
CORES="pcsx_rearmed mupen64plus_next parallel_n64 ppsspp nestopia snes9x gambatte mgba genesis_plus_gx mednafen_pce_fast"

# What each core is and which files it opens
INFO_REPO=https://github.com/libretro/libretro-core-info

# Raise when the bundle's contents change: it names the file handhelds fetch
BUNDLE=1
