# Kernel modules the 5.10 kernel's own build leaves out, built here from the
# same source and added to the image. Raise the pin on purpose, when
# build/upstream.env moves to a kernel built from a later commit, then try
# the module on a handheld.

# Source of arkos4clone's 5.10 kernel (its build recipe is tools/arkos4clone
# in that repository: clone_defconfig, release <version>-arkos4clone)
KERNEL_REPO=https://github.com/jokubasver/rockchip-kernel
KERNEL_COMMIT=f2d282f266a4641a8cd4664ae1ebc11cb8bff301
KERNEL_DEFCONFIG=clone_defconfig
# the release the modules must carry: the folder under /usr/lib/modules
KERNEL_RELEASE=5.10.252-arkos4clone

# The modules as one file, rk-kernel-modules-<KMODS_BUNDLE>.tar.xz, which each
# release carries: a card that is updated and not flashed again takes them
# from there (rk-tools kernel-modules). Raise the number whenever the file's
# contents change, here and in overlay/usr/share/rk/kernel-modules.bundle.
KMODS_BUNDLE=1

# What is added: "CONFIG_OPTION path/to/module.ko", one per line.
#   ch341: the USB-serial chip (CH340/CH341) of most ESP32 boards, a Freenove
#   ESP32-WROVER among them. Without it such a board gets no /dev/ttyUSB*.
EXTRA_MODULES="
USB_SERIAL_CH341 drivers/usb/serial/ch341.ko
"
