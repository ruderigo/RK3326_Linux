# Where the boot chain, kernels, device trees and kernel modules come from.
# arkos4clone is pinned to one commit so every build uses the same files;
# raise UPSTREAM_COMMIT on purpose, then test the image on a handheld.
UPSTREAM_REPO=https://github.com/lcdyk0517/arkos4clone
UPSTREAM_COMMIT=c462a40f3d7e240c23a0c6be95f70ba9b48c37e7

# Debian release of the system
DEBIAN_SUITE=trixie
DEBIAN_MIRROR=http://deb.debian.org/debian
